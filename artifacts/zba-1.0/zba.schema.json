{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research.talktoai.org/spec/zba/1.0/schema.json",
  "title": "Zero Boundary Algebra Evidence Record 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["spec", "asset_id", "sequence", "operation", "polarity", "phase", "recursion_depth", "policy_id", "policy_version", "previous_commitment", "payload_commitment", "evidence_status", "commitment_algorithm", "commitment"],
  "properties": {
    "spec": {"const": "zba-evidence/1.0"},
    "asset_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "sequence": {"type": "integer", "minimum": 0},
    "operation": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,63}$"},
    "polarity": {"enum": ["positive", "neutral", "negative"]},
    "phase": {"enum": ["entering", "boundary", "emerging"]},
    "recursion_depth": {"type": "integer", "minimum": 0, "maximum": 4294967295},
    "policy_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "policy_version": {"type": "string", "minLength": 1, "maxLength": 64},
    "previous_commitment": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "payload_commitment": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "event_time": {"type": "string", "format": "date-time"},
    "actor_id": {"type": "string", "maxLength": 256},
    "evidence_status": {"enum": ["claimed", "checked", "sealed", "rejected"]},
    "commitment_algorithm": {"const": "sha-256"},
    "commitment": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "critical": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "signature": {"type": "object"},
    "external_anchor": {"type": "object"}
  }
}
